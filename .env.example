# ============================================================
#  Inteliaudit — Variables de Entorno (Dev-Server & Producción)
# ============================================================

PORT=8001
# Base de datos:
# Local dev: sqlite+aiosqlite:///./inteliaudit.db
# Dev-Server Docker Postgres:
DATABASE_URL=postgresql://postgres:password@10.0.1.7:5432/inteliaudit

# Seguridad JWT & Encriptación
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex
ENCRYPTION_KEY=

# Dominio y CORS
ALLOWED_ORIGINS=["https://inteliaudit.vercel.app","https://inteliaudit.intellihouse.lat","http://localhost:3000","http://localhost:5173","http://localhost:8001"]
FRONTEND_URL=https://inteliaudit.vercel.app

# Proveedores de IA (Gemini / Claude)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Almacenamiento (Cloudflare R2 - S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=inteliaudit
STORAGE_PATH=/home/dev-server/apps/inteliaudit/storage

# Emails transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=Inteliaudit <noreply@inteliaudit.com>

# Telemetría y Analytics (PostHog)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

PYTHONUNBUFFERED=1
